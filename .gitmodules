# This feature branch needs Witchhunt's SDK integration plus the reviewed
# UC8279/LUT68 inverted text-AA change. Pin our published fork so recursive
# clones can fetch the exact driver source used by the tests and firmware.
# The base retains Witchhunt's board and grayscale APIs absent from upstream
# Free-Ink main; do not replace it with upstream main or a floating SDK head.
[submodule "freeink-sdk"]
	path = freeink-sdk
	url = https://github.com/elijahandrews/freeink-sdk.git
	branch = feature/dark-mode-aa
