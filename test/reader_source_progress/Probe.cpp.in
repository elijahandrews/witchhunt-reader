#include <cassert>
#include <atomic>
#include <iostream>
#include <optional>
#include "activities/reader/EpubProgressRecord.h"
#include "activities/reader/EpubJumpBack.h"
#include "SourceAnchor.h"
#define LOG_DBG(...) ((void)0)
#define LOG_INF(...) ((void)0)
#define LOG_ERR(...) ((void)0)

struct SectionProbe {
  bool active = false, anchorReady = true;
  int pageCount = 50, currentPage = 0;
  mutable int reads = 0;
  SourceAnchor anchor{9876, 0};
  bool rangeReady=true;
  std::optional<uint16_t> liveAnchorPage;
  std::optional<uint16_t> activeBuildPageForTocIndex(int) const { return liveAnchorPage; }
  std::optional<uint16_t> activeBuildPageForAnchor(const std::string&) const { return liveAnchorPage; }
  SourceRange range{40,100};
  mutable int lastRangePage=-1;
  mutable int visibleLookups = 0, rawLookups = 0;
  std::optional<uint16_t> getPageForVisibleTextOffset(uint32_t offset) const {
    ++visibleLookups; return offset == 50 ? std::optional<uint16_t>(3) : std::nullopt;
  }
  std::optional<uint16_t> getPageForSourceOffset(SourceAnchor at) const {
    ++rawLookups; return at.sourceOffset == 50 && at.characterOffset == 2 ? std::optional<uint16_t>(7) : std::nullopt;
  }
  std::optional<SourceRange> getSourceRangeForPage(uint16_t page) const {
    lastRangePage=page; return rangeReady ? std::optional<SourceRange>(range) : std::nullopt;
  }
  std::optional<uint16_t> sourceLookupPage() const { return std::nullopt; }
  std::optional<uint16_t> getPageForTocIndex(int) const { return std::nullopt; }
  std::optional<uint16_t> getPageForAnchor(const std::string&) const { return std::nullopt; }
  std::optional<uint16_t> getPageForListItemIndex(uint16_t) const { return std::nullopt; }
  std::optional<uint16_t> getPageForParagraphIndex(uint16_t) const { return 5; }
  bool isTruncatedCache() const { return false; }
  bool hasActiveBuild() const { return active; }
  std::optional<uint16_t> getParagraphIndexForPage(uint16_t) const { return 91; }
  std::optional<SourceAnchor> getSourceAnchorForPage(uint16_t) const { ++reads; return anchorReady ? std::optional<SourceAnchor>(anchor) : std::nullopt; }
};
using Section = SectionProbe;
struct EpubProbe { int getSpineItemsCount() const { return 10; } };
// This wrapper owns no IO resources, but exposes the production section lifetime API.
struct SectionHandle {
  SectionProbe* value = nullptr;
  SectionHandle& operator=(SectionProbe* p) { value=p; return *this; }
  SectionProbe* operator->() const { return value; }
  SectionProbe& operator*() const { return *value; }
  explicit operator bool() const { return value; }
  void reset() { value=nullptr; }
};
struct RenderLock {
  static inline int depth = 0;
  template<class T> explicit RenderLock(T&) { assert(depth == 0); ++depth; }
  ~RenderLock() { --depth; }
};
struct RendererProbe {
  bool refreshPending = false;
  bool isRefreshPending() const { return refreshPending; }
  bool fastRefreshNeedsHostFrame() const { return false; }
};
unsigned long millis() { return 100; }
struct SessionProbe { void onPageTurn() {} };
SessionProbe& globalReadingSessionTracker() { static SessionProbe session; return session; }
namespace ReaderUtils { inline void enforceExitFullRefresh(RendererProbe&) {} }
class EpubReaderActivity {
 public:
// NAVIGATION_DECLARATION
  int currentSpineIndex = 3;
  NavigationTarget navTarget;
  SourceAnchor reflowSource_;
  int reflowSourceSpine_ = -1, reflowSourcePage_ = -1;
  SectionHandle section;
  using SavedPosition = EpubLinkBackStack::Entry;
  EpubJumpBack jumpBack_;
  SavedPosition savedPositions[EpubLinkBackStack::kMaxDepth];
  int footnoteDepth=0, sessionLinkDepth_=0, updates=0, stackChanges=0;
  RendererProbe renderer;
  bool pendingPreRender=false, usePreRenderedBuffer=false, preRenderedPlanesStaged_=false;
  struct { bool active=false; } pendingGrayscale_;
  struct {
    bool ready=false; int spineIndex=-1, pageIndex=-1;
    unsigned long renderDurationMs=0, completedAtMs=0;
    bool incomplete=false; uint32_t textAaGeneration=0;
  } preRenderedPage;
  uint32_t capturedTextAaGeneration_ = 0;
  bool buildingPopupShown_=false, forceHalfRefreshAfterPopup_=false;
  bool forceLoadLargeImages=false, pageHasPlaceholders=false;
  int sessionPagesAdvanced=0;
  unsigned long lastPageTurnTime=0;
  struct {
    int spineIndex=0, page=0, pageCount=0;
    std::atomic<bool> pending{false};
  } pendingProgressSave;
  static constexpr unsigned PAGE_TURN_STATS_WINDOW_SIZE=20;
  struct {
    unsigned turns=0, preRenderHits=0, preRenderMisses=0;
    unsigned long totalPreRenderMs=0, totalIdleSlackMs=0;
  } pageTurnStatsWindow;
  bool allowLockedUpdate=false;
  void anchorNavTargetToCurrentPage(bool preserveSourceAnchor=false);
  bool stepPageState(bool);
  bool stepPageStateLocked(bool);
  void pageTurn(bool);
  void jumpPages(bool, int);
  enum class RenderPass { FinishedBook, SectionBuilding, BufferDisplay, PreRender, BuildSection, Normal };
  RenderPass classifyRenderPass() const;
  void armPreparedDisplay() {
    pendingGrayscale_.active=pendingPreRender=usePreRenderedBuffer=preRenderedPlanesStaged_=true;
    preRenderedPage.ready=true;
    preRenderedPage.spineIndex=currentSpineIndex;
    preRenderedPage.pageIndex=section->currentPage;
    assert(classifyRenderPass()==RenderPass::BufferDisplay);
  }
  void assertRestoreCanceledDisplay() const {
    assert(!pendingGrayscale_.active && !pendingPreRender && !usePreRenderedBuffer);
    assert(!preRenderedPage.ready && !preRenderedPlanesStaged_ && !section);
    assert(classifyRenderPass()==RenderPass::BuildSection);
  }
  int pendingFollowedLinkPage_=-1, pendingFollowedLinkSpine_=-1;
  static constexpr int MAX_FOOTNOTE_DEPTH=EpubLinkBackStack::kMaxDepth;
  void clearPendingFollowedLink();
  void settleFollowedLink(int page);
  void resolveLiveLink() { // LIVE_LINK_STATEMENTS
  }
  bool captureCurrentPosition(SavedPosition&) const;
  void captureSourceBeforeReflow();
  NavigationTarget savedPositionTarget(const SavedPosition&) const;
  void rememberJumpOrigin(bool followedLink=false);
  void clearJumpBack();
  void returnFromJump();
  void restorePosition(const SavedPosition&);
  void restoreSavedPosition();
  void requestUpdate() { assert(RenderLock::depth == 0 || allowLockedUpdate); ++updates; }
  void noteLinkBackStackChanged() { assert(RenderLock::depth == 1); ++stackChanges; }
  EpubProbe* epub = nullptr;
  enum class ReaderPhase { READING, PRECOMPILING };
  ReaderPhase readerPhase_ = ReaderPhase::READING;
  std::optional<EpubProgressRecord> saved;
  EpubProgressRecord::Shown shownProgress() const { return EpubProgressRecord::Shown{}; }
  void saveProgress(int spine, int page, int count, std::optional<uint16_t> paragraph,
                    std::optional<EpubProgressRecord::Shown> shown, std::optional<EpubProgressRecord::Source> source) {
    EpubProgressRecord record;
    record.spineIndex = spine; record.page = page; record.pageCount = count;
    record.paragraph = paragraph; record.shown = shown; record.source = source; saved = record;
  }
  void closeProgress() { // CLOSE_STATEMENTS
  }
  std::optional<EpubProgressRecord::Source> sourceForProgress(int spine, int page) const;
  void restore(const EpubProgressRecord* record) { // RESTORE_STATEMENTS
  }
};
// PAGE_TURN_IMPLEMENTATION
// JUMP_IMPLEMENTATION
// CLASSIFY_IMPLEMENTATION
// CAPTURE_IMPLEMENTATION
// NAVIGATION_IMPLEMENTATION

int main() {
  // Two queued inputs can run before the render task sees the first request.
  // Exercise real pageTurn/jumpPages/stepPageStateLocked and classification.
  using Pass = EpubReaderActivity::RenderPass;
  for (int second=0; second<5; ++second) {
    EpubReaderActivity r; SectionProbe s; EpubProbe e;
    r.section=&s; r.epub=&e; r.allowLockedUpdate=true; s.currentPage=10;
    r.preRenderedPage={true, r.currentSpineIndex, 11, 20, 50, false, 7};
    r.preRenderedPlanesStaged_=true; r.capturedTextAaGeneration_=7;
    r.pageTurn(true);
    assert(s.currentPage==11 && r.usePreRenderedBuffer && !r.preRenderedPage.ready);
    assert(r.classifyRenderPass()==Pass::BufferDisplay);
    if (second==0) r.pageTurn(true);
    if (second==1) r.pageTurn(false);
    if (second==2) r.jumpPages(true,10);
    if (second==3) r.jumpPages(false,10);
    if (second==4) {
      r.jumpPages(true,0); // A refused navigation must preserve the good handoff.
      assert(r.usePreRenderedBuffer && r.classifyRenderPass()==Pass::BufferDisplay);
      continue;
    }
    assert(s.currentPage==(second==0 ? 12 : second==1 ? 10 : second==2 ? 21 : 1));
    assert(!r.usePreRenderedBuffer && !r.pendingPreRender && !r.preRenderedPlanesStaged_);
    assert(r.capturedTextAaGeneration_==0 && r.classifyRenderPass()==Pass::Normal);
  }
  // A stale handoff from another navigation route must never select old pixels.
  for (int mismatch=0; mismatch<6; ++mismatch) {
    EpubReaderActivity r; SectionProbe s; EpubProbe e;
    r.section=&s; r.epub=&e; r.usePreRenderedBuffer=true;
    r.preRenderedPage={false, r.currentSpineIndex, s.currentPage, 0, 0, false, 0};
    assert(r.classifyRenderPass()==Pass::BufferDisplay);
    if (mismatch==0) ++s.currentPage;
    if (mismatch==1) ++r.currentSpineIndex;
    if (mismatch==2) r.preRenderedPage.incomplete=true;
    if (mismatch==3) r.section.reset();
    if (mismatch==4) r.renderer.refreshPending=true;
    if (mismatch==5) { ++s.currentPage; r.pendingPreRender=true; }
    assert(r.classifyRenderPass()==(mismatch==3 ? Pass::BuildSection : Pass::Normal));
  }
  // Crossing a chapter after the cached last page must dispatch a section build.
  {
    EpubReaderActivity r; SectionProbe s; EpubProbe e;
    r.section=&s; r.epub=&e; r.allowLockedUpdate=true; s.currentPage=s.pageCount-2;
    r.preRenderedPage={true,r.currentSpineIndex,s.pageCount-1};
    r.pageTurn(true); r.pageTurn(true);
    assert(!r.section && !r.usePreRenderedBuffer && r.currentSpineIndex==4);
    assert(r.classifyRenderPass()==Pass::BuildSection);
  }
  EpubReaderActivity reader;
  SectionProbe section;
  reader.section = &section;
  // The same numeric offset means different things in raw XHTML and KOReader's
  // visible-text coordinate space. Compile both branches from production source.
  using Target = EpubReaderActivity::NavigationTarget;
  auto rawTarget = Target::makeSourceOffset(50, 0, 2);
  auto visibleTarget = Target::makeVisibleOffset(50);
  rawTarget.resolveInto(section, 3);
  assert(section.currentPage == 7 && section.rawLookups == 1 && section.visibleLookups == 0);
  visibleTarget.resolveInto(section, 3);
  assert(section.currentPage == 3 && section.rawLookups == 1 && section.visibleLookups == 1);
  section.active = true;
  assert(!rawTarget.sourceTargetPage(section) && section.rawLookups == 1);
  assert(!visibleTarget.sourceTargetPage(section));
  section.active = false;
  for (auto target : {Target::makeSourceOffset(999, 20), Target::makeVisibleOffset(999, 20)}) {
    target.cachedSpineIdx = 3; target.cachedPageCount = 100;
    target.resolveInto(section, 3);
    assert(section.currentPage == 10); // Both preserve upstream bounded rescaling on a miss.
  }

  assert(!reader.sourceForProgress(2, 12));
  assert(section.reads == 0);
  auto source = reader.sourceForProgress(3, 12);
  assert(source && source->offset == 9876 && section.reads == 1);
  reader.reflowSource_ = {1234, 87};
  reader.reflowSourceSpine_ = 3; reader.reflowSourcePage_ = 12;
  for (int cycle = 0; cycle < 5; ++cycle) {
    section.anchor = {static_cast<uint32_t>(9000 + cycle), 0};
    source = reader.sourceForProgress(3, 12);
    assert(source && source->offset == 1234 && source->characterOffset == 87);
  }
  assert(section.reads == 1); // Sticky target never regresses to earlier new-page text.
  source = reader.sourceForProgress(3, 13);
  assert(source && source->offset == 9004); // Deliberate navigation updates provenance.
  reader.navTarget = EpubReaderActivity::NavigationTarget::makeSourceOffset(4567, 12, 99);
  section.active = true;
  source = reader.sourceForProgress(3, 0);
  assert(source && source->offset == 4567 && source->characterOffset == 99);
  assert(section.reads == 2); // Indexing page-zero never replaces pending source.
  EpubProgressRecord record;
  record.spineIndex = 3; record.page = 12; record.pageCount = 50;
  record.paragraph = 1; record.source = source;
  uint8_t data[EpubProgressRecord::kMaxSize] = {};
  const auto restored = EpubProgressRecord::decode(data, record.encode(data));
  assert(restored);
  reader.restore(&*restored);
  assert(reader.navTarget.kind == EpubReaderActivity::NavigationTarget::Kind::Source);
  assert(reader.navTarget.sourceOffset == 4567 && reader.navTarget.sourceCharacterOffset == 99);
  assert(reader.navTarget.fallbackPage == 12 && reader.navTarget.cachedPageCount == 50);
  assert(reader.navTarget.cachedSpineIdx == 3 && reader.navTarget.restoreParagraph == 0);
  record.source.reset(); reader.restore(&record);
  assert(reader.navTarget.kind == EpubReaderActivity::NavigationTarget::Kind::Page);
  assert(reader.navTarget.page == 12 && reader.navTarget.restoreParagraph == 1);
  reader.navTarget = {};
  reader.reflowSource_ = {};
  section.anchorReady = false;
  assert(!reader.sourceForProgress(3, 0)); // Unbuilt live page has no anchor.
  section.anchorReady = true;
  assert(reader.sourceForProgress(3, 0)->offset == 9004); // Built live page is safe to persist.
  section.active = false;
  assert(!reader.sourceForProgress(3, -1));
  assert(!reader.sourceForProgress(3, 50));
  EpubProbe epub;
  reader.epub = &epub;
  reader.navTarget = EpubReaderActivity::NavigationTarget::makeSourceOffset(4567, 12, 99);
  reader.navTarget.cachedPageCount = 50;
  section.active = true; section.currentPage = 0;
  reader.closeProgress();
  assert(reader.saved && reader.saved->source);
  assert(reader.saved->page == 12 && reader.saved->pageCount == 50);
  assert(reader.saved->source->offset == 4567 && reader.saved->source->characterOffset == 99);
  reader.navTarget = EpubReaderActivity::NavigationTarget::makePage(13);
  section.currentPage = 13;
  reader.closeProgress();
  assert(reader.saved->page == 13 && reader.saved->pageCount == 0);
  assert(reader.saved->source && reader.saved->source->offset == 9004);
  assert(!reader.saved->shown && !reader.saved->paragraph);
  reader.reflowSource_ = {1234, 87}; section.active = false; section.currentPage = 12;
  reader.closeProgress();
  assert(reader.saved->page == 12 && reader.saved->pageCount == 50);
  assert(reader.saved->source && reader.saved->source->offset == 1234);
  assert(reader.saved->source->characterOffset == 87);
  assert(reader.saved->shown && reader.saved->paragraph == 91);
  reader.saved.reset(); reader.epub = nullptr;
  reader.closeProgress(); assert(!reader.saved);
  reader.epub = &epub; reader.currentSpineIndex = 10;
  reader.closeProgress(); assert(!reader.saved);
  // A real source-captured jump must restore the caller's precise source, not
  // the beginning of its multi-page paragraph. Generic jumps leave link history alone.
  reader.currentSpineIndex=3; reader.section=&section;
  section.currentPage=19; section.pageCount=80; section.anchor={50,2};
  reader.navTarget=Target::makePage(19);
  reader.footnoteDepth=1; reader.sessionLinkDepth_=1;
  reader.savedPositions[0].spineIndex=1; reader.savedPositions[0].pageNumber=7;
  {
    RenderLock lock(reader); reader.rememberJumpOrigin();
  }
  reader.currentSpineIndex=8; reader.section.reset();
  reader.navTarget=Target::makePercent(.8f);
  // Input may arrive before the prepared page's queued render runs. Both Back
  // variants must cancel that handoff, then dispatch to a new section build.
  reader.section=&section; reader.armPreparedDisplay();
  reader.returnFromJump();
  reader.assertRestoreCanceledDisplay();
  assert(reader.currentSpineIndex==3 && !reader.section && reader.updates==1);
  assert(reader.navTarget.kind==Target::Kind::Source && reader.navTarget.sourceOffset==50);
  assert(reader.navTarget.sourceCharacterOffset==2 && reader.navTarget.fallbackPage==19);
  assert(reader.footnoteDepth==1 && reader.stackChanges==0 && !reader.jumpBack_.available());
  reader.returnFromJump(); assert(reader.updates==1); // consumed: no second navigation

  // Resizing or rotating from a reader menu destroys section before action
  // dispatch. Capture the retained source target, not a nonexistent page zero.
  reader.navTarget=Target::makeSourceOffset(50,19,2);
  reader.navTarget.cachedPageCount=80; reader.navTarget.cachedSpineIdx=3;
  {
    RenderLock lock(reader); reader.rememberJumpOrigin();
  }
  assert(reader.jumpBack_.available());
  reader.navTarget=Target::makePercent(.9f); reader.currentSpineIndex=8;
  reader.returnFromJump();
  assert(reader.currentSpineIndex==3 && reader.navTarget.sourceOffset==50);
  assert(reader.navTarget.fallbackPage==19 && reader.navTarget.cachedPageCount==80);
  // During incremental reflow a section exists, but page zero is still the
  // indexing cursor. The pending target, including split-word character, wins.
  reader.section=&section; section.active=true; section.currentPage=0;
  section.anchor={999,0};
  { RenderLock lock(reader); reader.rememberJumpOrigin(); }
  reader.currentSpineIndex=8; reader.section.reset();
  reader.navTarget=Target::makePercent(.9f); reader.returnFromJump();
  assert(reader.currentSpineIndex==3 && reader.navTarget.sourceOffset==50);
  assert(reader.navTarget.sourceCharacterOffset==2 && reader.navTarget.fallbackPage==19);
  section.active=false; section.currentPage=19; section.anchor={50,2};

  // Following a link uses the same precise restoration but consumes that link's
  // persistent Back entry too. The test lock refuses nested acquisition.
  reader.section=&section; reader.navTarget=Target::makePage(19);
  EpubReaderActivity::SavedPosition caller;
  assert(reader.captureCurrentPosition(caller));
  reader.savedPositions[0]=caller;
  { RenderLock lock(reader); reader.rememberJumpOrigin(true); }
  for(int i=0;i<5;++i) reader.jumpBack_.pageTurned();
  reader.currentSpineIndex=8; reader.armPreparedDisplay();
  reader.returnFromJump();
  reader.assertRestoreCanceledDisplay();
  assert(reader.currentSpineIndex==3 && reader.footnoteDepth==0 && reader.sessionLinkDepth_==0);
  assert(reader.stackChanges==1 && reader.navTarget.sourceCharacterOffset==2);
  assert(!reader.jumpBack_.available());

  // Legacy entries have no source: same layout returns the exact saved page,
  // while only a changed layout may fall back to the paragraph LUT.
  caller.sourceOffset=UINT32_MAX; caller.pageNumber=19; caller.pageCount=80;
  caller.hasParagraph=true; caller.paragraphIndex=7;
  auto legacy=reader.savedPositionTarget(caller);
  section.pageCount=80; legacy.resolveInto(section,3);
  assert(section.currentPage==19);
  section.pageCount=100; legacy.resolveInto(section,3);
  assert(section.currentPage==5);

  // No loaded section and no source target is not a trustworthy jump origin.
  reader.section.reset(); reader.navTarget=Target::makeAnchor("not-loaded");
  { RenderLock lock(reader); reader.rememberJumpOrigin(); }
  assert(!reader.jumpBack_.available());
  // A Return may resolve before its page interval has been emitted. Retry
  // against that same destination even if an ordinary turn advances the cursor.
  reader.section=&section; reader.currentSpineIndex=3;
  reader.savedPositions[0]=caller;
  reader.savedPositions[0].sourceOffset=50;
  reader.savedPositions[0].sourceRangeStart=100;
  reader.savedPositions[0].sourceRangeEnd=200;
  reader.savedPositions[1].spineIndex=8;
  reader.footnoteDepth=reader.sessionLinkDepth_=2;
  reader.navTarget=Target::makeAnchor("caller"); reader.navTarget.followedLink=true;
  section.active=true; section.rangeReady=false; section.currentPage=0;
  {
    RenderLock lock(reader); reader.resolveLiveLink();
  }
  assert(reader.footnoteDepth==2 && reader.pendingFollowedLinkPage_==-1);
  assert(reader.navTarget.followedLink && reader.navTarget.kind==Target::Kind::Anchor);
  section.liveAnchorPage=16;
  {
    RenderLock lock(reader); reader.resolveLiveLink();
  }
  assert(reader.footnoteDepth==2 && reader.pendingFollowedLinkPage_==16);
  assert(section.currentPage==16 && reader.navTarget.kind==Target::Kind::Page);
  reader.navTarget=Target::makePage(17); section.currentPage=17;
  section.rangeReady=true; section.range={150,250};
  {
    RenderLock lock(reader); reader.resolveLiveLink();
  }
  assert(section.lastRangePage==16 && reader.footnoteDepth==0 && reader.sessionLinkDepth_==0);
  assert(reader.pendingFollowedLinkPage_==-1);

  // A coincidental page number after reflow is not enough: source intervals
  // meeting at a boundary or wholly outside the origin must not unwind history.
  for (auto range : {SourceRange{200,250}, SourceRange{300,400}}) {
    reader.footnoteDepth=reader.sessionLinkDepth_=2;
    section.range=range; section.active=false;
    reader.navTarget=Target::makeAnchor("elsewhere"); reader.navTarget.followedLink=true;
    { RenderLock lock(reader); reader.settleFollowedLink(caller.pageNumber); }
    assert(reader.footnoteDepth==2 && reader.pendingFollowedLinkPage_==-1);
  }
  // A deliberate new jump cancels any retry belonging to the old link.
  reader.pendingFollowedLinkPage_=16; reader.pendingFollowedLinkSpine_=3;
  { RenderLock lock(reader); reader.rememberJumpOrigin(); }
  assert(reader.pendingFollowedLinkPage_==-1 && reader.pendingFollowedLinkSpine_==-1);
  reader.pendingFollowedLinkPage_=16; reader.pendingFollowedLinkSpine_=2;
  { RenderLock lock(reader); reader.settleFollowedLink(16); }
  assert(reader.pendingFollowedLinkPage_==-1 && reader.pendingFollowedLinkSpine_==-1);
  reader.pendingFollowedLinkPage_=16; reader.pendingFollowedLinkSpine_=3;
  reader.navTarget=Target::makeSourceOffset(50,19,2); reader.navTarget.followedLink=true;
  { RenderLock lock(reader); reader.captureSourceBeforeReflow(); }
  assert(reader.pendingFollowedLinkPage_==-1 && !reader.navTarget.followedLink);
  assert(reader.navTarget.kind==Target::Kind::Source && reader.navTarget.sourceOffset==50);
  assert(RenderLock::depth==0);
  std::cout << "PASS: production source capture/restore, menu reflow, precise jump/link Back and queued-display cancellation\n";
}
